{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "noEmit": true,
    "paths": {
      "@shared/*": ["./shared/*"],
      "@database/*": ["./database/*"]
    }
  },
  "include": ["electron/**/*", "shared/**/*", "database/**/*", "electron.vite.config.ts", "drizzle.config.ts", "vitest.config.ts", "tests/unit/node/**/*", "tests/e2e/**/*", "playwright.config.ts"]
}
